# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# UAE PASS (mocked integration)
# Salt/pepper for hashing the Emirates ID before it ever touches the database.
# Rotate with a new pepper_version; old hashes stay verifiable-by-version.
# The static (GitHub Pages) build hashes in the browser, so this value ships in
# the bundle and is a demo salt, not a secret. Must be 16+ characters.
# ---------------------------------------------------------------------------
UAE_PASS_HASH_PEPPER=change-me-to-a-long-random-string
NEXT_PUBLIC_UAE_PASS_HASH_PEPPER=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# AI assistant (wired in Phase 6)
# ---------------------------------------------------------------------------
AI_API_KEY=
